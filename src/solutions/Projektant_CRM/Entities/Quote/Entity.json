{
  "name": "Quote",
  "table": "quotes",
  "displayName": "Nabídka",
  "displayNamePlural": "Nabídky",
  "primaryField": "name",
  "statusReasonOptionSetKey": "quote_status_reason",
  "fields": [
    { "name": "number", "label": "Číslo nabídky", "type": "text" },
    { "name": "name", "label": "Název nabídky", "type": "text", "required": true },
    { "name": "nazev_stavby", "label": "Název stavby (tiskne se jako Název)", "type": "text" },
    { "name": "project_id", "label": "Projekt", "type": "lookup", "targetEntity": "Project", "required": true },
    { "name": "contact_id", "label": "Objednatel", "type": "lookup", "targetEntity": "Contact", "required": true },
    { "name": "zadavatel_text", "label": "Zadavatel – jméno, adresa (prázdné = z objednatele)", "type": "text" },
    { "name": "supplier_profile_id", "label": "Dodavatel", "type": "lookup", "targetEntity": "SupplierProfile" },
    { "name": "odberatel_je_firma", "label": "Vystavit na firmu objednatele", "type": "boolean" },
    { "name": "je_platce_dph", "label": "Vystaveno jako plátce DPH", "type": "boolean", "readOnly": true },
    { "name": "valid_until", "label": "Platnost do", "type": "date" },
    { "name": "vat_rate", "label": "Sazba DPH (%)", "type": "number" },
    { "name": "zobrazit_soucet", "label": "Zobrazit součet", "type": "boolean" },
    { "name": "poznamky", "label": "Poznámky v nabídce (jedna na řádek)", "type": "textarea" },
    { "name": "note", "label": "Interní poznámka (kopíruje se do faktury)", "type": "textarea" }
  ]
}
