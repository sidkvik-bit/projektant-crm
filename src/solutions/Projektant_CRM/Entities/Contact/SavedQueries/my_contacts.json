{
  "entity": "Contact",
  "name": "my_contacts",
  "label": "Moje kontakty",
  "columns": [
    { "field": "first_name", "label": "Jméno" },
    { "field": "last_name", "label": "Příjmení" },
    { "field": "account", "label": "Obchodní vztah" },
    { "field": "email" },
    { "field": "phone", "label": "Telefon" },
    { "field": "status_reason", "label": "Stav" }
  ],
  "defaultSort": { "field": "created_at", "direction": "desc" },
  "conditions": [
    { "field": "owner_id", "operator": "eq", "value": "$currentUser" },
    { "field": "status", "operator": "eq", "value": "active" }
  ]
}
