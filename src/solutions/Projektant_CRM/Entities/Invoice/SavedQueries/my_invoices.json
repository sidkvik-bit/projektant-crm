{
  "entity": "Invoice",
  "name": "my_invoices",
  "label": "Moje faktury",
  "columns": [
    { "field": "number", "label": "Číslo" },
    { "field": "name" },
    { "field": "project", "label": "Projekt" },
    { "field": "status_reason", "label": "Stav" },
    { "field": "datum_splatnosti", "label": "Splatnost" },
    { "field": "total", "label": "Celkem s DPH" }
  ],
  "defaultSort": { "field": "created_at", "direction": "desc" },
  "conditions": [
    { "field": "owner_id", "operator": "eq", "value": "$currentUser" },
    { "field": "status", "operator": "eq", "value": "active" }
  ]
}
