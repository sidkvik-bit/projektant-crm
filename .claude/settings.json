{
  "permissions": {
    "deny": ["Read(./.env*)", "Edit(./.env*)", "Write(./.env*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/risk-gate.mjs\""
          }
        ]
      }
    ]
  }
}
